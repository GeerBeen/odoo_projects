<odoo noupdate="1">
    <record id="ir_cron_parse_uah_to_currencies" model="ir.cron">
        <field name="name">Parse UAH to currencies</field>
        <field name="model_id" ref="model_res_currency"/>
        <field name="state">code</field>
        <field name="code">model._cron_parse_currencies()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')"/>
    </record>
</odoo>
